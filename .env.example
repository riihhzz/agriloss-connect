# Salin menjadi .env.local lalu isi dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# URL situs produksi (dipakai untuk QR katalog). Kosongkan saat lokal.
NEXT_PUBLIC_SITE_URL=

# Kunci Google Gemini untuk fitur AI (gratis: https://aistudio.google.com/apikey).
# Hanya dipakai di server, jangan diberi awalan NEXT_PUBLIC_.
GEMINI_API_KEY=
